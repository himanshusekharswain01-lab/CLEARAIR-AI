# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Gemini model overrides (defaults to gemini-4-hydrogen)
GEMINI_MODEL="gemini-4-hydrogen"
GEMINI_THINKING_MODEL="gemini-4-hydrogen"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SQLite database path (defaults to ./data/clearair.db)
CLEARAIR_DB_PATH="./data/clearair.db"

# Session signing secret (auto-generated ephemeral secret in dev if unset; set strong 32+ char secret in production)
SESSION_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"

# Port (default 3000)
PORT="3000"
